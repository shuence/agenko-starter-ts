# ── Vercel AI Gateway ──────────────────────────────────────────────────────
# Option A: an API key from the Gateway dashboard.
AI_GATEWAY_API_KEY=vck_...
# Option B: no key at all — run `vercel link` and the CLI writes a
# short-lived VERCEL_OIDC_TOKEN to .env.local (Vercel does this automatically
# for deployments).

# Any Gateway slug works. Default is a free, tool-capable model.
AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-free

# ── Agenko (optional) ──────────────────────────────────────────────────────
# Leave these empty for local mode: receipts are computed in-process and
# streamed to the UI. Set a key to also persist receipts, traces and
# approvals in the Agenko control plane.
# AGENKO_API_KEY=agk_...
# AGENKO_HOST=http://localhost:8000
# AGENKO_CONSOLE_URL=https://console.agenko.app
# AGENKO_SERVICE_NAME=agenko-starter
# AGENKO_DEBUG=0
